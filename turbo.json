{
  "$schema": "./node_modules/turbo/schema.json",
  // turbo otherwise writes a guidance block into the generated AGENTS.md
  "agentGuidance": false,
  // every package's tsconfig extends one of the base tsconfigs, and both load the shared
  // declarations, so a change to one reruns every package's cached typecheck
  "globalDependencies": [
    "tsconfig.base.json",
    "research/tsconfig.base.json",
    "nixie-test-build.d.ts",
    "bun-serve-options.d.ts"
  ],
  "tasks": {
    "typecheck": {
      // a package typechecks against its dependencies' source, which its own hash leaves out
      "cache": false
    }
  },
  "boundaries": {
    "tags": {
      "app": {
        "dependencies": { "allow": ["module", "adapter", "lib"] }
      },
      "client": {
        "dependencies": { "allow": ["lib"] }
      },
      "sidecar": {
        "dependencies": { "allow": ["lib"] }
      },
      "module": {
        "dependencies": { "allow": ["module", "lib"] }
      },
      "adapter": {
        "dependencies": { "allow": ["module", "lib"] }
      },
      "guest": {
        "dependencies": { "allow": ["lib"] }
      },
      "lib": {
        "dependencies": { "allow": ["lib"] }
      },
      // a deployment's own program imports the Kubernetes component, which nothing in the
      // workspace imports and which imports no workspace package
      "deploy": {
        "dependencies": { "allow": [] }
      },
      // an eval runs production code from any layer against a committed corpus, and nothing
      // depends on it
      "eval": {
        "dependencies": { "allow": ["module", "guest", "lib"] }
      },
      // the whole-program suites run builds of the server, the web client and the backup job as
      // child processes, and nothing depends on them
      "e2e": {
        "dependencies": {
          "allow": ["app", "client", "sidecar", "module", "adapter", "lib", "e2e-support"]
        }
      },
      // the helpers that build the web client and the backup job for the whole-program suites,
      // which only those suites may depend on, so product code never reaches test code
      "e2e-support": {
        "dependencies": { "allow": ["client", "sidecar", "lib"] },
        "dependents": { "allow": ["e2e"] }
      },
      // the in-process suites run one flow across several packages on the server's test harnesses,
      // and nothing depends on them
      "integration": {
        "dependencies": { "allow": ["app", "module", "adapter", "lib"] }
      },
      "server-only": {
        "dependents": {
          "allow": [
            "app",
            "module",
            "adapter",
            "server-only",
            "eval",
            "e2e",
            "e2e-support",
            "integration"
          ]
        }
      }
    }
  }
}
