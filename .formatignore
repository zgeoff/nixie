# lefthook.yml repeats these globs in the format-codemod exclude; change both

# verbatim copies that repo-sync delivers from zgeoff/tools; edit them there
.claude/hooks/start.ts

# generated by TanStack Router on every web build
apps/web/src/routeTree.gen.ts
# written by panda codegen on install
apps/web/src/styled-system/**
# written by `codex app-server generate-ts` for the pinned CLI
guests/codex/src/protocol/**

# written by the secret scan lib's rule builder, and the pin check compares its bytes
libs/secret-scan/src/generated/public-rules.generated.ts

# spikes are throwaway code; only their Markdown is formatted
research/**

# build output
**/dist/**
**/coverage/**

# nested checkouts
.worktrees/**
