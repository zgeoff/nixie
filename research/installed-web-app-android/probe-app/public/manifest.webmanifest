{
  "id": "/",
  "name": "nixie probe",
  "short_name": "probe",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0f766e",
  "theme_color": "#0f766e",
  "icons": [
    { "src": "/icons/launcher-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/launcher-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "/icons/launcher-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["image/*", "video/*", "application/pdf", "text/plain"] }]
    }
  }
}
