{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@zgeoff/oxlint-config/oxlintrc.json"],
  "env": {
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    ".claude/**",
    ".reviews/**",
    ".worktrees/**",
    "docs/design/**",
    "research/**",
    // generated by TanStack Router on every web build
    "apps/web/src/routeTree.gen.ts",
    // written by panda codegen on install
    "apps/web/src/styled-system/**"
  ],
  "rules": {
    // a library contract fixes each name; the project-code-style skill gives the reasons
    "zgeoff/function-verb": [
      "error",
      {
        "exemptNames": [
          "executeQuery",
          // the seeder work deletes each name as it moves that seed
          "seed",
          "seedClientAction",
          "seedConversationStep",
          "seedData",
          "seedFailedStep",
          "seedFailedTurn",
          "seedSessionBoundary",
          "seedStartedTask",
          "seedTask",
          "seedWrittenSkills"
        ]
      }
    ],
    // the seeder work turns both seed rules on once every seeder exists
    "zgeoff/seed-only": "off",
    "zgeoff/test-beside-seed": "off",
    // the list holds the packages not yet folded and shrinks as each is folded
    "zgeoff/feature-folders": [
      "error",
      {
        "pending": [
          "adapters/sandbox-imp",
          "apps/model-gateway",
          "apps/server",
          "apps/web",
          "guests/conversation",
          "guests/fetch",
          "libs/contract",
          "libs/db",
          "libs/testing",
          "libs/wire",
          "modules/actions",
          "modules/api",
          "modules/backup",
          "modules/compaction",
          "modules/connectors",
          "modules/definitions",
          "modules/log",
          "modules/memory",
          "modules/models",
          "modules/ops",
          "modules/policy",
          "modules/prompts",
          "modules/sandbox",
          "modules/sessions",
          "modules/skills",
          "modules/tasks"
        ]
      }
    ],
    // the import boundaries: each outside system has one package that may import it, and every
    // import names its module where the zones can see it
    "zgeoff/import-zones": [
      "error",
      {
        "zones": {
          // the SDK contract suite drives the Agent SDK itself, to check it, and the memory checker
          // and writer evals swap the brokered key for the local login
          "agent-sdk": [
            "guests/conversation/**",
            "evals/sdk-contract/**",
            "evals/memory-checker/run-memory-checker-eval.ts",
            "evals/memory-writer/run-memory-writer-eval.ts"
          ],
          "imp-client": ["adapters/sandbox-imp/**"],
          "db": ["libs/db/**"]
        },
        "modules": [
          {
            "name": "agent-sdk",
            "modules": ["@anthropic-ai/claude-agent-sdk"],
            "allow": ["agent-sdk"],
            "reason": "only guests/conversation, and the evals that check the Agent SDK itself, import the Agent SDK"
          },
          {
            "name": "imp-client",
            "modules": ["@impz/client"],
            "allow": ["imp-client"],
            "reason": "only adapters/sandbox-imp imports imp's client"
          },
          {
            "name": "sqlite",
            "modules": ["bun:sqlite"],
            "allow": ["db"],
            "reason": "only libs/db opens SQLite; use @heynixie/db"
          }
        ],
        "unresolved": [
          {
            "name": "unresolved",
            "reason": "the zones cannot judge an import whose module they cannot see"
          }
        ]
      }
    ],
    // the mock GitHub's lifecycle runs once per test file, as a preload would
    "import/no-unassigned-import": [
      "error",
      { "allow": ["jest-extended", "**/augment-bun-test.ts", "**/run-github-mock"] }
    ]
  },
  "overrides": [
    {
      "files": ["libs/db/src/nixie-tables.ts"],
      // generated from the migrations: its length grows with the schema, not with complexity
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": ["libs/db/src/migrations/[0-9][0-9][0-9][0-9]-*.ts"],
      // the number in the file name orders the migrations, so the name cannot match the export
      "rules": {
        "zgeoff/file-named-for-export": "off"
      }
    }
  ]
}
