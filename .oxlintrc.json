{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@zgeoff/oxlint-config/oxlintrc.json"],
  "jsPlugins": ["./scripts/oxlint/nixie-plugin.js"],
  "env": {
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    ".claude/**",
    ".reviews/**",
    ".worktrees/**",
    "docs/design/**",
    "research/**",
    // generated by TanStack Router on every web build
    "apps/web/src/routeTree.gen.ts",
    // written by panda codegen on install
    "apps/web/src/styled-system/**",
    // written by `codex app-server generate-ts` for the pinned CLI
    "guests/codex/src/protocol/**",
    // written by the secret scan lib's rule builder, and the pin check compares its bytes
    "libs/secret-scan/src/generated/public-rules.generated.ts"
  ],
  "rules": {
    // a library contract fixes each name; the project-code-style skill gives the reasons
    "zgeoff/function-verb": [
      "error",
      {
        "exemptNames": ["executeQuery"]
      }
    ],
    // a read of the secrets file's groups goes through the credentials module
    "nixie/no-credential-group-reads": "error",
    "zgeoff/seed-only": "error",
    "zgeoff/test-beside-seed": "error",
    // the import boundaries: each outside system has one package that may import it, and every
    // import names its module where the zones can see it
    "zgeoff/import-zones": [
      "error",
      {
        "zones": {
          // the SDK contract suite drives the Agent SDK itself, to check it, and the memory checker
          // and writer evals swap the brokered key for the local login
          "agent-sdk": [
            "guests/conversation/**",
            "evals/sdk-contract/**",
            "evals/memory-checker/run-memory-checker-eval.ts",
            "evals/memory-writer/run-memory-writer-eval.ts"
          ],
          "imp-client": ["adapters/sandbox-imp/**"],
          "db": ["libs/db/**"],
          "onnx-runtime": ["adapters/encoder-onnx/**"],
          "cel": ["modules/policy/**"]
        },
        "modules": [
          {
            "name": "agent-sdk",
            "modules": ["@anthropic-ai/claude-agent-sdk"],
            "allow": ["agent-sdk"],
            "reason": "only guests/conversation, and the evals that check the Agent SDK itself, import the Agent SDK"
          },
          {
            "name": "imp-client",
            "modules": ["@impz/client"],
            "allow": ["imp-client"],
            "reason": "only adapters/sandbox-imp imports imp's client"
          },
          {
            "name": "sqlite",
            "modules": ["bun:sqlite"],
            "allow": ["db"],
            "reason": "only libs/db opens SQLite; use @heynixie/db"
          },
          {
            "name": "onnx-runtime",
            "modules": ["onnxruntime-node", "@huggingface/tokenizers"],
            "allow": ["onnx-runtime"],
            "reason": "only adapters/encoder-onnx imports the ONNX runtime and its tokenizer"
          },
          {
            "name": "cel",
            "modules": ["@marcbachmann/cel-js"],
            "allow": ["cel"],
            "reason": "only modules/policy imports the CEL library, so a version bump touches one package"
          }
        ],
        "unresolved": [
          {
            "name": "unresolved",
            "reason": "the zones cannot judge an import whose module they cannot see"
          }
        ]
      }
    ],
    // the mock GitHub's lifecycle runs once per test file, as a preload would
    "import/no-unassigned-import": [
      "error",
      { "allow": ["jest-extended", "**/augment-bun-test.ts", "**/run-github-mock"] }
    ]
  },
  "overrides": [
    {
      "files": ["modules/credentials/**"],
      // the credentials module is the one reader of the secrets file's groups
      "rules": {
        "nixie/no-credential-group-reads": "off"
      }
    },
    {
      "files": ["verify/src/verify/prod/prod-target.test.ts"],
      // the test runs the verify CLI as a process, so no single module sits beside it
      "rules": {
        "zgeoff/test-beside-module": "off"
      }
    },
    {
      "files": ["integration/*.test.ts"],
      // each test drives one flow across several packages, so no single module sits beside it
      "rules": {
        "zgeoff/test-beside-module": "off"
      }
    },
    {
      "files": ["libs/db/src/nixie-tables.ts"],
      // generated from the migrations: its length grows with the schema, not with complexity
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": ["libs/db/src/migrations/[0-9][0-9][0-9][0-9]-*.ts"],
      // the number in the file name orders the migrations, so the name cannot match the export
      "rules": {
        "zgeoff/file-named-for-export": "off"
      }
    }
  ]
}
