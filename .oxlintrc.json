{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@zgeoff/oxlint-config/oxlintrc.json"],
  "jsPlugins": ["./oxlint-plugin.js"],
  "env": {
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    ".claude/**",
    ".reviews/**",
    ".worktrees/**",
    "docs/design/**",
    "research/**",
    // generated by TanStack Router on every web build
    "apps/web/src/routeTree.gen.ts",
    // written by panda codegen on install
    "apps/web/src/styled-system/**"
  ],
  "rules": {
    // a library or wire contract fixes each name; the project-code-style skill gives the reasons
    "zgeoff/function-verb": ["error", { "exemptNames": ["executeQuery", "fetch", "process"] }],
    // the import boundaries: each outside system has one package that may import it, and every
    // import names its module where the zones can see it
    "zgeoff/import-zones": [
      "error",
      {
        "zones": {
          // the SDK contract suite and its helpers drive the Agent SDK itself, to check it, and the
          // memory checker and writer evals swap the brokered key for the local login
          "agent-sdk": [
            "guests/conversation/**",
            "evals/sdk-contract/**",
            "evals/memory-checker/run-memory-checker-eval.ts",
            "evals/memory-writer/run-memory-writer-eval.ts",
            "evals/test-utils/collect-tool-calls*.ts",
            "evals/test-utils/run-contract-query*.ts",
            "evals/test-utils/start-input-stream*.ts"
          ],
          "imp-client": ["adapters/sandbox-imp/**"],
          "db": ["libs/db/**"]
        },
        "modules": [
          {
            "name": "agent-sdk",
            "modules": ["@anthropic-ai/claude-agent-sdk"],
            "allow": ["agent-sdk"],
            "reason": "only guests/conversation, and the evals that check the Agent SDK itself, import the Agent SDK"
          },
          {
            "name": "imp-client",
            "modules": ["@impz/client"],
            "allow": ["imp-client"],
            "reason": "only adapters/sandbox-imp imports imp's client"
          },
          {
            "name": "sqlite",
            "modules": ["bun:sqlite"],
            "allow": ["db"],
            "reason": "only libs/db opens SQLite; use @heynixie/db"
          },
          {
            "name": "create-require",
            "modules": ["node:module"],
            "allow": [],
            "reason": "its require function loads modules the zones cannot see; use import"
          }
        ],
        "unresolved": [
          {
            "name": "unresolved",
            "reason": "the zones cannot judge an import whose module they cannot see"
          }
        ]
      }
    ],
    "no-restricted-globals": [
      "error",
      {
        "name": "require",
        "message": "A require function loads modules the import zones cannot see; use import."
      }
    ],
    "import/no-commonjs": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "nixie/test-shape": "error"
      }
    }
  ]
}
