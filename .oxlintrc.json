{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@zgeoff/oxlint-config/oxlintrc.json"],
  "jsPlugins": ["./oxlint-plugin.js"],
  "env": {
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    ".claude/**",
    ".reviews/**",
    ".worktrees/**",
    "docs/design/**",
    "research/**",
    // generated by TanStack Router on every web build
    "apps/web/src/routeTree.gen.ts",
    // written by panda codegen on install
    "apps/web/src/styled-system/**"
  ],
  "rules": {
    // oxlint 1.86 enables one-var through the style category, which the shared config predates; it
    // forbids the separate const per step that every test body uses
    "one-var": "off",
    // format-codemod owns blank-line spacing, so the size limits count code, not padding
    "max-lines": ["error", { "max": 300, "skipBlankLines": true }],
    "max-lines-per-function": ["error", { "max": 50, "skipBlankLines": true }],
    // a callback's parameter takes its type from the caller, such as a test.each row; the allowed
    // types are library and platform handles, which no caller can make readonly, and ReadonlyMap,
    // which the rule reads as mutable
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "ignoreInferredTypes": true,
        "allow": [
          {
            "from": "package",
            "package": "kysely",
            "name": ["CompiledQuery", "DatabaseConnection", "Kysely", "Transaction"]
          },
          { "from": "package", "package": "bun:ffi", "name": ["Pointer"] },
          { "from": "package", "package": "bun:sqlite", "name": ["Database", "SQLQueryBindings"] },
          {
            "from": "lib",
            "name": ["Date", "Error", "EventTarget", "Promise", "ReadonlyMap", "Uint8Array"]
          },
          {
            "from": "package",
            "package": "bun-types",
            "name": [
              "AbortSignal",
              "Blob",
              "CryptoKey",
              "ErrorEvent",
              "EventTarget",
              "MessageEvent",
              "ReadableStream",
              "Worker"
            ]
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@anthropic-ai/claude-agent-sdk",
            "message": "Only guests/conversation imports the Agent SDK."
          },
          {
            "name": "@zgeoff/imp-client",
            "message": "Only adapters/sandbox-imp imports imp's client."
          },
          {
            "name": "bun:sqlite",
            "message": "Only libs/db opens SQLite; use @heynixie/db."
          },
          {
            "name": "node:module",
            "importNames": ["createRequire"],
            "message": "A require function escapes no-restricted-imports; use import."
          },
          {
            "name": "module",
            "importNames": ["createRequire"],
            "message": "A require function escapes no-restricted-imports; use import."
          }
        ],
        "patterns": [
          {
            "group": ["@anthropic-ai/claude-agent-sdk/*"],
            "message": "Only guests/conversation imports the Agent SDK."
          },
          {
            "group": ["@zgeoff/imp-client/*"],
            "message": "Only adapters/sandbox-imp imports imp's client."
          }
        ]
      }
    ],
    "no-restricted-globals": [
      "error",
      {
        "name": "require",
        "message": "A require function escapes no-restricted-imports; use import."
      }
    ],
    "import/no-commonjs": "error",
    "nixie/no-hidden-import": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "nixie/test-shape": "error"
      }
    },
    {
      // a crash test is one journey whose phases depend on the ones before it: start, hold at a
      // fault point, kill, restart, then the oracle; the poisoned page journey runs a turn, then
      // the writer batch over the records the turn left
      "files": ["e2e/crash/*.test.ts", "e2e/poisoned-page.test.ts"],
      "rules": {
        "max-statements": "off",
        "max-lines-per-function": "off"
      }
    },
    {
      // a contract probe drives the session's earlier turns before the one it checks, each turn
      // depending on the one before it
      "files": ["evals/sdk-contract/*.test.ts"],
      "rules": {
        "max-statements": "off",
        "max-lines-per-function": "off",
        "import/max-dependencies": "off"
      }
    },
    {
      // the SDK contract suite and its helpers drive the Agent SDK itself, to check it
      "files": [
        "evals/sdk-contract/**",
        "evals/test-utils/collect-tool-calls*.ts",
        "evals/test-utils/run-contract-query*.ts",
        "evals/test-utils/start-input-stream*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@zgeoff/imp-client",
                "message": "Only adapters/sandbox-imp imports imp's client."
              },
              {
                "name": "bun:sqlite",
                "message": "Only libs/db opens SQLite; use @heynixie/db."
              },
              {
                "name": "node:module",
                "importNames": ["createRequire"],
                "message": "A require function escapes no-restricted-imports; use import."
              },
              {
                "name": "module",
                "importNames": ["createRequire"],
                "message": "A require function escapes no-restricted-imports; use import."
              }
            ],
            "patterns": [
              {
                "group": ["@zgeoff/imp-client/*"],
                "message": "Only adapters/sandbox-imp imports imp's client."
              }
            ]
          }
        ]
      }
    },
    {
      // the web client passes browser and React handles, such as an image's File and the events
      // that carry it, which no caller can make readonly
      "files": ["apps/web/**"],
      "rules": {
        "typescript/prefer-readonly-parameter-types": [
          "error",
          {
            "ignoreInferredTypes": true,
            "allow": [
              {
                "from": "lib",
                "name": [
                  "AbortSignal",
                  "Blob",
                  "Date",
                  "Element",
                  "Error",
                  "File",
                  "Headers",
                  "InputEvent",
                  "ReadonlySet",
                  "Request",
                  "Response",
                  "Uint8Array"
                ]
              },
              { "from": "package", "package": "bun-types", "name": ["Blob", "File", "WebView"] },
              {
                "from": "package",
                "package": "react",
                "name": ["ClipboardEvent", "DragEvent", "KeyboardEvent", "ReactNode", "RefObject"]
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["guests/conversation/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@zgeoff/imp-client",
                "message": "Only adapters/sandbox-imp imports imp's client."
              },
              {
                "name": "bun:sqlite",
                "message": "Only libs/db opens SQLite; use @heynixie/db."
              },
              {
                "name": "node:module",
                "importNames": ["createRequire"],
                "message": "A require function escapes no-restricted-imports; use import."
              },
              {
                "name": "module",
                "importNames": ["createRequire"],
                "message": "A require function escapes no-restricted-imports; use import."
              }
            ],
            "patterns": [
              {
                "group": ["@zgeoff/imp-client/*"],
                "message": "Only adapters/sandbox-imp imports imp's client."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["adapters/sandbox-imp/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@anthropic-ai/claude-agent-sdk",
                "message": "Only guests/conversation imports the Agent SDK."
              },
              {
                "name": "bun:sqlite",
                "message": "Only libs/db opens SQLite; use @heynixie/db."
              },
              {
                "name": "node:module",
                "importNames": ["createRequire"],
                "message": "A require function escapes no-restricted-imports; use import."
              },
              {
                "name": "module",
                "importNames": ["createRequire"],
                "message": "A require function escapes no-restricted-imports; use import."
              }
            ],
            "patterns": [
              {
                "group": ["@anthropic-ai/claude-agent-sdk/*"],
                "message": "Only guests/conversation imports the Agent SDK."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["libs/db/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@anthropic-ai/claude-agent-sdk",
                "message": "Only guests/conversation imports the Agent SDK."
              },
              {
                "name": "@zgeoff/imp-client",
                "message": "Only adapters/sandbox-imp imports imp's client."
              },
              {
                "name": "node:module",
                "importNames": ["createRequire"],
                "message": "A require function escapes no-restricted-imports; use import."
              },
              {
                "name": "module",
                "importNames": ["createRequire"],
                "message": "A require function escapes no-restricted-imports; use import."
              }
            ],
            "patterns": [
              {
                "group": ["@anthropic-ai/claude-agent-sdk/*"],
                "message": "Only guests/conversation imports the Agent SDK."
              },
              {
                "group": ["@zgeoff/imp-client/*"],
                "message": "Only adapters/sandbox-imp imports imp's client."
              }
            ]
          }
        ]
      }
    }
  ]
}
