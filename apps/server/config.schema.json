{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "server": {
      "type": "object",
      "properties": {
        "data_dir": {
          "default": "/data",
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "default": "0.0.0.0",
          "type": "string",
          "minLength": 1
        },
        "port": {
          "default": 8080,
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "secrets_file": {
          "default": "/etc/nixie/secrets.yaml",
          "type": "string",
          "minLength": 1
        },
        "log_level": {
          "default": "info",
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        }
      },
      "additionalProperties": false
    },
    "owner": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "pronouns": {
          "default": {
            "they": "they",
            "their": "their"
          },
          "type": "object",
          "properties": {
            "they": {
              "type": "string",
              "minLength": 1
            },
            "their": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "they",
            "their"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "names": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "models": {
      "type": "object",
      "properties": {
        "profiles": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "base_url": {
                "type": "string",
                "format": "uri",
                "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://"
              },
              "credential": {
                "type": "string",
                "pattern": "^deployment:[\\w-]+$"
              },
              "auth_header": {
                "type": "string",
                "enum": [
                  "bearer",
                  "x-api-key"
                ]
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "effort": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              },
              "provider_pin": {
                "type": "string",
                "minLength": 1
              },
              "context_tokens": {
                "type": "integer",
                "minimum": 100000,
                "maximum": 1000000
              },
              "cache_ttl": {
                "type": "string",
                "enum": [
                  "5m",
                  "1h"
                ]
              },
              "prices": {
                "type": "object",
                "properties": {
                  "input": {
                    "type": "number",
                    "minimum": 0
                  },
                  "cache_write": {
                    "type": "number",
                    "minimum": 0
                  },
                  "cache_write_1h": {
                    "type": "number",
                    "minimum": 0
                  },
                  "cached_input": {
                    "type": "number",
                    "minimum": 0
                  },
                  "output": {
                    "type": "number",
                    "minimum": 0
                  },
                  "long_prompt": {
                    "type": "object",
                    "properties": {
                      "input": {
                        "type": "number",
                        "minimum": 0
                      },
                      "cache_write": {
                        "type": "number",
                        "minimum": 0
                      },
                      "cache_write_1h": {
                        "type": "number",
                        "minimum": 0
                      },
                      "cached_input": {
                        "type": "number",
                        "minimum": 0
                      },
                      "output": {
                        "type": "number",
                        "minimum": 0
                      },
                      "over_tokens": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "input",
                      "cache_write",
                      "cache_write_1h",
                      "cached_input",
                      "output",
                      "over_tokens"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "input",
                  "cache_write",
                  "cache_write_1h",
                  "cached_input",
                  "output"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "base_url",
              "credential",
              "auth_header",
              "model",
              "effort"
            ],
            "additionalProperties": false
          }
        },
        "roles": {
          "type": "object",
          "properties": {
            "conversation": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "task": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "worker": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "checker": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "memory-writer": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "memory-consolidator": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "additionalProperties": false,
          "required": [
            "conversation"
          ]
        }
      },
      "required": [
        "profiles",
        "roles"
      ],
      "additionalProperties": false
    },
    "compaction": {
      "type": "object",
      "properties": {
        "threshold": {
          "default": 0.8,
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "heads_up": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "summary_tokens": {
          "default": 2000,
          "type": "integer",
          "minimum": 100,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "sandbox": {
      "default": {
        "adapter": "imp"
      },
      "type": "object",
      "properties": {
        "adapter": {
          "default": "imp",
          "type": "string",
          "enum": [
            "imp"
          ]
        }
      },
      "additionalProperties": false
    },
    "imp": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://"
        },
        "host_addresses": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:\\d{1,3}(?:\\.\\d{1,3}){3}(?:\\/\\d{1,2})?|[\\da-fA-F:]*:[\\da-fA-F:.]*(?:\\/\\d{1,3})?)$"
          }
        },
        "egress_deny": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:\\d{1,3}(?:\\.\\d{1,3}){3}(?:\\/\\d{1,2})?|[\\da-fA-F:]*:[\\da-fA-F:.]*(?:\\/\\d{1,3})?)$"
          }
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "definitions": {
      "type": "object",
      "properties": {
        "source": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "path"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "path"
              ],
              "additionalProperties": false
            }
          ]
        },
        "probe_interval_ms": {
          "default": 300000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "export": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[\\w.-]+\\/[\\w.-]+$"
            },
            "base": {
              "default": "main",
              "type": "string",
              "minLength": 1
            },
            "api_url": {
              "default": "https://api.github.com",
              "type": "string",
              "format": "uri"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "repository"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    },
    "web_fetch": {
      "type": "object",
      "properties": {
        "body_bytes": {
          "default": 2097152,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "timeout_ms": {
          "default": 15000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "redirects": {
          "default": 5,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "text_bytes": {
          "default": 20000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
