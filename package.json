{
  "name": "nixie",
  "version": "0.0.0",
  "private": true,
  "description": "A personal assistant platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/nixie.git"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "modules/*",
      "guests/*",
      "adapters/*",
      "libs/*",
      "evals",
      "e2e",
      "research/*",
      "!research/encoder",
      "!research/fetch-headless",
      "!research/voice-latency"
    ],
    "catalog": {
      "@anthropic-ai/claude-agent-sdk": "0.3.290",
      "@babel/core": "8.0.6",
      "@faker-js/faker": "10.6.0",
      "@huggingface/tokenizers": "0.2.0",
      "@modelcontextprotocol/client": "2.3.0",
      "@modelcontextprotocol/server": "2.3.0",
      "@msw/data": "1.1.8",
      "@orpc/client": "1.15.4",
      "@orpc/contract": "1.15.4",
      "@orpc/openapi": "1.15.4",
      "@orpc/server": "1.15.4",
      "@orpc/tanstack-query": "1.15.4",
      "@orpc/zod": "1.15.4",
      "@pandacss/dev": "2.1.1",
      "@paralleldrive/cuid2": "3.3.0",
      "@pandacss/preset-base": "2.1.1",
      "@pandacss/preset-panda": "2.1.1",
      "@rolldown/plugin-babel": "0.2.4",
      "@tanstack/query-core": "5.104.1",
      "@tanstack/react-query": "5.104.1",
      "@tanstack/react-router": "1.170.41",
      "@tanstack/react-router-ssr-query": "1.167.3",
      "@tanstack/react-start": "1.168.60",
      "@testing-library/react": "16.3.3",
      "@testing-library/user-event": "14.6.7",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@vitejs/plugin-react": "6.1.1",
      "@zgeoff/imp-client": "1.6.0",
      "babel-plugin-react-compiler": "1.0.0",
      "elysia": "1.4.30",
      "fake-indexeddb": "6.2.5",
      "gunshi": "1.0.0-rc.1",
      "happy-dom": "20.14.5",
      "kysely": "0.29.6",
      "msw": "2.15.0",
      "onnxruntime-node": "1.30.0",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "react-markdown": "10.1.0",
      "remark-gfm": "4.0.1",
      "tiny-invariant": "1.3.3",
      "vite": "8.3.2",
      "zod": "4.6.5"
    }
  },
  "type": "module",
  "scripts": {
    "audit": "bun audit",
    "boundaries": "turbo boundaries",
    "check": "bun run audit && bun run deadcode && bun run format:check && bun run lint:full && bun run typecheck && bun run boundaries && bun run prose && bun run test",
    "deadcode": "knip",
    "format": "oxfmt . && format-codemod --quiet .",
    "format:check": "oxfmt --check . && format-codemod --check --quiet .",
    "lint": "oxlint",
    "lint:full": "oxlint --type-aware --report-unused-disable-directives-severity error",
    "models": "bun adapters/encoder-onnx/src/run-pinned-download.ts adapters/encoder-onnx/model-files.txt node_modules/.cache/nixie-encoder",
    "postinstall": "bun run --cwd apps/web codegen",
    "prepare": "command -v git > /dev/null 2>&1 && lefthook install --force || true",
    "prose": "bash .claude/skills/docs-writing/scripts/check-prose.sh README.md AGENTS.md ':(glob)docs/**/*.md' ':(glob)research/**/*.md' .claude/skills/project-docs-writing .claude/skills/project-testing && bash .claude/skills/skill-writing/scripts/check-skill.sh && bash .claude/skills/code-style/scripts/check-project-verbs.sh",
    "test": "bun run models && bun test",
    "typecheck": "tsc --noEmit && turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.2",
    "@zgeoff/bun-test-extended": "0.1.0",
    "@zgeoff/bun-test-react": "0.1.0",
    "@zgeoff/format-codemod": "0.1.0",
    "@zgeoff/oxlint-config": "0.2.0",
    "knip": "6.39.0",
    "lefthook": "2.1.14",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2"
}
