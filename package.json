{
  "name": "nixie",
  "version": "0.0.0",
  "private": true,
  "description": "A personal assistant platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/nixie.git"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "modules/*",
      "guests/*",
      "adapters/*",
      "libs/*",
      "deploy/pulumi-k8s",
      "evals",
      "e2e",
      "integration",
      "research/*",
      "!research/encoder",
      "!research/fetch-headless",
      "!research/sandbox-memory",
      "!research/sdk-first-token",
      "!research/sdk-long-hold",
      "!research/sdk-reasoning",
      "!research/sdk-skills",
      "!research/voice-latency"
    ],
    "catalog": {
      "@anthropic-ai/claude-agent-sdk": "0.3.322",
      "@babel/core": "8.0.10",
      "@faker-js/faker": "10.6.0",
      "@huggingface/tokenizers": "0.2.0",
      "@impz/client": "6.11.5",
      "@impz/testing": "6.11.5",
      "@logtape/logtape": "2.4.2",
      "@modelcontextprotocol/client": "2.4.0",
      "@modelcontextprotocol/server": "2.4.0",
      "@msw/data": "1.1.8",
      "@orpc/client": "1.16.1",
      "@orpc/contract": "1.16.1",
      "@orpc/openapi": "1.16.1",
      "@orpc/server": "1.16.1",
      "@orpc/tanstack-query": "1.16.1",
      "@orpc/zod": "1.16.1",
      "@pandacss/dev": "2.4.0",
      "@paralleldrive/cuid2": "3.3.0",
      "@pulumi/kubernetes": "4.34.2",
      "@pulumi/pulumi": "3.273.0",
      "@pandacss/preset-base": "2.4.0",
      "@pandacss/preset-panda": "2.4.0",
      "@rolldown/plugin-babel": "0.3.0",
      "@tanstack/query-core": "5.105.1",
      "@tanstack/react-query": "5.105.1",
      "@tanstack/react-router": "1.170.46",
      "@tanstack/react-router-ssr-query": "1.167.3",
      "@tanstack/react-start": "1.169.4",
      "@testing-library/react": "16.3.3",
      "@testing-library/user-event": "14.6.8",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@vitejs/plugin-react": "6.1.2",
      "@zgeoff/kysely-bun-sqlite": "0.3.2",
      "@zgeoff/rig": "0.2.3",
      "@zgeoff/std": "0.4.3",
      "ajv": "8.20.0",
      "babel-plugin-react-compiler": "1.0.0",
      "elysia": "1.4.30",
      "entities": "9.0.0",
      "fake-indexeddb": "6.2.7",
      "fast-check": "4.10.2",
      "gunshi": "1.0.0-rc.1",
      "happy-dom": "21.0.4",
      "kysely": "0.29.8",
      "msw": "2.15.0",
      "onnxruntime-node": "1.31.1",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "react-markdown": "10.1.0",
      "remark-gfm": "4.0.1",
      "tiny-invariant": "1.3.3",
      "ts-pattern": "5.9.2",
      "vite": "8.3.5",
      "xstate": "5.33.3",
      "zod": "4.6.7"
    }
  },
  "type": "module",
  "scripts": {
    "audit": "bun audit --ignore=GHSA-3g3m-2fjr-6pw4 --ignore=GHSA-g3hv-75wg-m249",
    "boundaries": "turbo boundaries",
    "check": "bun run audit && bun run deadcode && bun run format:check && bun run lint:full && bun run typecheck && bun run boundaries && bun run prose && bun run test && bun run test:browser && bun run test:agent-sdk && bun run test:e2e && bun run test:journeys",
    "deadcode": "bash scripts/run-knip.sh",
    "format": "oxfmt . && format-codemod --quiet .",
    "format:check": "oxfmt --check . && format-codemod --check --quiet .",
    "lint": "oxlint",
    "lint:full": "tsgolint=$(tsrslint-path) && OXLINT_TSGOLINT_PATH=$tsgolint oxlint --type-aware --report-unused-disable-directives-severity error",
    "models": "bun adapters/encoder-onnx/src/run-pinned-download.ts adapters/encoder-onnx/model-files.txt node_modules/.cache/nixie-encoder",
    "postinstall": "bun run --cwd apps/web codegen",
    "prepare": "command -v git > /dev/null 2>&1 && lefthook install --force || true",
    "prose": "chex prose README.md AGENTS.md ':(glob)docs/**/*.md' ':(glob)research/**/*.md' .claude/skills/project-ci-design .claude/skills/project-code-style .claude/skills/project-docs-writing .claude/skills/project-testing && chex skill",
    "test": "bun run models && bun run test:bundles && rig unit --path-ignore-patterns='e2e/**'",
    "test:bundles": "bun apps/server/src/test-utils/write-test-bundles.ts",
    "test:web-build": "bun apps/web/src/test-utils/read-web-build.ts",
    "test:backup-job-build": "bun apps/backup-job/src/test-utils/read-backup-job-bundle.ts",
    "build:browser": "bun apps/web/src/test-utils/write-browser-build.ts",
    "test:browser": "rig browser --path-ignore-patterns='e2e/journeys/**' --path-ignore-patterns='e2e/src/**'",
    "test:agent-sdk": "rig agent-sdk",
    "test:e2e": "bun run models && bun run test:bundles && bun run test:web-build && bun run test:backup-job-build && bun test --parallel=1 --no-isolate --timeout=15000 --path-ignore-patterns='**/*.restic.test.ts' --path-ignore-patterns='**/*.browser.test.ts' e2e/ && bun run test:bundle",
    "test:bundle": "rig bundle",
    "test:journeys": "bun run test:bundles && rig browser e2e/journeys/ e2e/src/test-utils/start-web-journey.browser.test.ts",
    "test:restic": "rig restic",
    "typecheck": "workers=$(bun scripts/read-worker-count.ts) && tsrs --noEmit --checkers $workers && turbo run typecheck --concurrency=$workers -- --checkers $workers",
    "test:related": "bun run models && bun run test:bundles && rig related",
    "ci:compatibility:find-last-release": "bun scripts/compatibility/find-last-release.ts",
    "ci:compatibility:run-contract-growth-check": "bun scripts/compatibility/run-contract-growth-check.ts",
    "ci:compatibility:run-migration-check": "bun scripts/compatibility/run-migration-check.ts",
    "ci:compose:check-age-key": "bun scripts/compose/check-age-key.ts",
    "ci:compose:check-backup-credentials": "bun scripts/compose/check-backup-credentials.ts",
    "ci:compose:check-backup-published": "bun scripts/compose/check-backup-published.ts",
    "ci:compose:check-health-url": "bun scripts/compose/check-health-url.ts",
    "ci:compose:check-pinned-digests": "bun scripts/compose/check-pinned-digests.ts",
    "ci:compose:check-sign-in-code": "bun scripts/compose/check-sign-in-code.ts",
    "ci:compose:write-throwaway-secrets": "bun scripts/compose/write-throwaway-secrets.ts",
    "ci:config-schema:run-config-schema-check": "bun scripts/config-schema/run-config-schema-check.ts",
    "ci:images:check-backup-image": "bun scripts/images/check-backup-image.ts",
    "ci:images:check-carried-manifest": "bun scripts/images/check-carried-manifest.ts",
    "ci:images:check-printed-sandbox-images": "bun scripts/images/check-printed-sandbox-images.ts",
    "ci:images:rehearse-release-assets": "bun scripts/images/rehearse-release-assets.ts",
    "ci:images:run-restic-lane": "bun scripts/images/run-restic-lane.ts",
    "ci:images:tag-rehearsal-images": "bun scripts/images/tag-rehearsal-images.ts",
    "ci:images:write-sandbox-manifest": "bun scripts/images/write-sandbox-manifest.ts",
    "ci:release:check-unused-version": "bun scripts/release/check-unused-version.ts",
    "ci:release:publish-counting-proxy": "bun scripts/release/publish-counting-proxy.ts",
    "ci:release:publish-release-json": "bun scripts/release/publish-release-json.ts",
    "ci:release:record-sandbox-manifest": "bun scripts/release/record-sandbox-manifest.ts",
    "ci:release:resolve-release": "bun scripts/release/resolve-release.ts",
    "ci:release:write-release-notes": "bun scripts/release/write-release-notes.ts",
    "test:model-api": "rig model-api",
    "test:imp": "rig imp --config=bunfig.imp.toml",
    "check:docs": "chex prose length links readmes skill",
    "eval": "rig eval"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@maschwenk/tsrslint": "0.1.6",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.4",
    "@zgeoff/agent-hooks": "0.2.11",
    "@zgeoff/bun-test-extended": "0.2.3",
    "@zgeoff/bun-test-react": "0.2.3",
    "@zgeoff/chex": "0.2.6",
    "@zgeoff/commitlint-config": "0.1.0",
    "@zgeoff/diet": "0.2.2",
    "@zgeoff/format-codemod": "0.3.5",
    "@zgeoff/oxlint-config": "0.8.6",
    "@zgeoff/rig": "catalog:",
    "knip": "6.44.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "overrides": {
    "happy-dom": "21.0.4"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.4"
}
