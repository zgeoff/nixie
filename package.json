{
  "name": "nixie",
  "version": "0.0.0",
  "private": true,
  "description": "A personal assistant platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/nixie.git"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "modules/*",
      "guests/*",
      "adapters/*",
      "libs/*",
      "deploy/pulumi-k8s",
      "evals",
      "e2e",
      "research/*",
      "!research/encoder",
      "!research/fetch-headless",
      "!research/voice-latency"
    ],
    "catalog": {
      "@anthropic-ai/claude-agent-sdk": "0.3.296",
      "@babel/core": "8.0.7",
      "@faker-js/faker": "10.6.0",
      "@huggingface/tokenizers": "0.2.0",
      "@impz/client": "2.11.0",
      "@logtape/logtape": "2.4.1",
      "@modelcontextprotocol/client": "2.3.1",
      "@modelcontextprotocol/server": "2.3.1",
      "@msw/data": "1.1.8",
      "@orpc/client": "1.15.6",
      "@orpc/contract": "1.15.6",
      "@orpc/openapi": "1.15.6",
      "@orpc/server": "1.15.6",
      "@orpc/tanstack-query": "1.15.6",
      "@orpc/zod": "1.15.6",
      "@pandacss/dev": "2.2.0",
      "@paralleldrive/cuid2": "3.3.0",
      "@pulumi/kubernetes": "4.34.2",
      "@pulumi/pulumi": "3.269.0",
      "@pandacss/preset-base": "2.2.0",
      "@pandacss/preset-panda": "2.2.0",
      "@rolldown/plugin-babel": "0.2.4",
      "@tanstack/query-core": "5.104.2",
      "@tanstack/react-query": "5.104.2",
      "@tanstack/react-router": "1.170.44",
      "@tanstack/react-router-ssr-query": "1.167.3",
      "@tanstack/react-start": "1.169.2",
      "@testing-library/react": "16.3.3",
      "@testing-library/user-event": "14.6.7",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@vitejs/plugin-react": "6.1.2",
      "@zgeoff/kysely-bun-sqlite": "0.3.0",
      "@zgeoff/std": "0.3.0",
      "ajv": "8.20.0",
      "babel-plugin-react-compiler": "1.0.0",
      "elysia": "1.4.30",
      "entities": "8.1.0",
      "fake-indexeddb": "6.2.5",
      "gunshi": "1.0.0-rc.1",
      "happy-dom": "21.0.4",
      "kysely": "0.29.6",
      "msw": "2.15.0",
      "onnxruntime-node": "1.30.0",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "react-markdown": "10.1.0",
      "remark-gfm": "4.0.1",
      "tiny-invariant": "1.3.3",
      "ts-pattern": "5.9.0",
      "vite": "8.3.4",
      "xstate": "5.33.2",
      "zod": "4.6.7"
    }
  },
  "type": "module",
  "scripts": {
    "audit": "bun audit",
    "boundaries": "turbo boundaries",
    "check": "bun run audit && bun run deadcode && bun run format:check && bun run lint:full && bun run typecheck && bun run boundaries && bun run prose && bun run test",
    "deadcode": "knip",
    "format": "oxfmt . && format-codemod --quiet .",
    "format:check": "oxfmt --check . && format-codemod --check --quiet .",
    "lint": "oxlint",
    "lint:full": "oxlint --type-aware --report-unused-disable-directives-severity error",
    "models": "bun adapters/encoder-onnx/src/run-pinned-download.ts adapters/encoder-onnx/model-files.txt node_modules/.cache/nixie-encoder",
    "postinstall": "bun run --cwd apps/web codegen",
    "prepare": "command -v git > /dev/null 2>&1 && lefthook install --force || true",
    "prose": "bash .claude/skills/docs-writing/scripts/check-prose.sh README.md AGENTS.md ':(glob)docs/**/*.md' ':(glob)research/**/*.md' .claude/skills/project-code-style .claude/skills/project-docs-writing .claude/skills/project-testing && bash .claude/skills/skill-writing/scripts/check-skill.sh",
    "test": "bun run models && bun test --parallel --path-ignore-patterns='docs/design/**' --path-ignore-patterns='research/**' --path-ignore-patterns='**/*.browser.test.ts' --path-ignore-patterns='**/*.sdk.test.ts' --path-ignore-patterns='e2e/**' && bun test --preload ./apps/web/src/test-utils/start-browser.ts .browser.test.ts && bun test --parallel=1 --timeout=30000 .sdk.test.ts e2e/",
    "typecheck": "tsrs --noEmit && turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.3",
    "@zgeoff/bun-test-extended": "0.2.1",
    "@zgeoff/bun-test-react": "0.2.1",
    "@zgeoff/format-codemod": "0.3.1",
    "@zgeoff/oxlint-config": "0.6.3",
    "@zgeoff/skill-gate": "0.2.6",
    "knip": "6.41.0",
    "lefthook": "2.2.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@happy-dom/global-registrator": "21.0.4",
    "happy-dom": "21.0.4"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.3"
}
