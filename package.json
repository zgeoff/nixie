{
  "name": "nixie",
  "version": "0.0.0",
  "private": true,
  "description": "A personal assistant platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/nixie.git"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "modules/*",
      "guests/*",
      "adapters/*",
      "libs/*",
      "deploy/pulumi-k8s",
      "evals",
      "verify",
      "integration",
      "research/*",
      "!research/encoder",
      "!research/fetch-headless",
      "!research/sandbox-memory",
      "!research/sdk-first-token",
      "!research/sdk-long-hold",
      "!research/sdk-reasoning",
      "!research/sdk-skills",
      "!research/voice-latency"
    ],
    "catalog": {
      "@anthropic-ai/claude-agent-sdk": "0.3.330",
      "@atcx/client": "8.0.0",
      "@atcx/contract": "8.0.0",
      "@babel/core": "8.1.2",
      "@faker-js/faker": "10.6.0",
      "@huggingface/tokenizers": "0.2.0",
      "@impz/client": "7.8.0",
      "@impz/testing": "7.8.0",
      "@logtape/logtape": "2.4.2",
      "@marcbachmann/cel-js": "8.0.0",
      "@modelcontextprotocol/client": "2.4.0",
      "@modelcontextprotocol/server": "2.4.0",
      "@msw/data": "1.1.8",
      "@novnc/novnc": "1.7.0",
      "@mswjs/interceptors": "0.45.12",
      "@orpc/client": "1.16.2",
      "@orpc/contract": "1.16.2",
      "@orpc/openapi": "1.16.2",
      "@orpc/server": "1.16.2",
      "@orpc/tanstack-query": "1.16.2",
      "@orpc/zod": "1.16.2",
      "@pandacss/dev": "2.6.0",
      "@paralleldrive/cuid2": "3.3.0",
      "@pulumi/kubernetes": "4.34.3",
      "@pulumi/pulumi": "3.277.0",
      "@pandacss/preset-base": "2.6.0",
      "@pandacss/preset-panda": "2.6.0",
      "@rolldown/plugin-babel": "0.3.1",
      "@simplewebauthn/browser": "14.0.0",
      "@simplewebauthn/server": "14.1.0",
      "@tanstack/query-core": "5.108.0",
      "@tanstack/react-query": "5.108.0",
      "@tanstack/react-router": "1.170.46",
      "@tanstack/react-router-ssr-query": "1.167.3",
      "@tanstack/react-start": "1.169.7",
      "@testing-library/react": "16.3.3",
      "@testing-library/user-event": "14.6.12",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@vitejs/plugin-react": "6.3.0",
      "@wringer/browser": "0.2.1",
      "@wringer/core": "0.4.1",
      "@wringer/db": "0.1.8",
      "@wringer/gunshi": "0.3.11",
      "@wringer/http": "0.1.9",
      "@wringer/stream": "0.1.8",
      "@wringer/terminal": "0.1.5",
      "@zgeoff/kysely-bun-sqlite": "0.3.3",
      "@zgeoff/rig": "0.3.2",
      "@zgeoff/std": "0.4.5",
      "@zgeoff/testing": "0.4.3",
      "ajv": "8.20.0",
      "babel-plugin-react-compiler": "1.0.0",
      "elysia": "1.4.32",
      "entities": "9.0.0",
      "fake-indexeddb": "6.2.8",
      "fast-check": "4.10.2",
      "gunshi": "1.0.0-rc.9",
      "happy-dom": "21.0.4",
      "kysely": "0.29.9",
      "msw": "3.0.4",
      "onnxruntime-node": "1.31.1",
      "playwright-core": "1.65.1",
      "re2js": "2.10.0",
      "rrule-temporal": "2.3.0",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "react-markdown": "10.1.0",
      "remark-gfm": "4.0.1",
      "tiny-invariant": "1.3.3",
      "tldts": "7.5.5",
      "ts-pattern": "5.9.2",
      "typescript": "7.0.2",
      "unbash": "6.0.4",
      "vite": "8.3.8",
      "xstate": "5.33.4",
      "zod": "4.6.7"
    }
  },
  "type": "module",
  "scripts": {
    "audit": "bun audit --ignore=GHSA-3g3m-2fjr-6pw4 --ignore=GHSA-g3hv-75wg-m249",
    "boundaries": "turbo boundaries",
    "check": "bun run audit && bun run deadcode && bun run format:check && bun run lint:full && bun run typecheck && bun run boundaries && bun run ci:contract:check-forgettable-kinds && bun run prose && bun run test && bun run test:browser && bun run test:agent-sdk && bun run test:e2e && bun run test:journeys",
    "deadcode": "bash scripts/run-knip.sh",
    "format": "oxfmt . && format-codemod --quiet .",
    "format:check": "oxfmt --check . && format-codemod --check --quiet .",
    "lint": "oxlint",
    "lint:full": "TSRS_FAST=1 oxlint --type-aware --type-check --report-unused-disable-directives-severity error",
    "models": "bun adapters/encoder-onnx/src/run-pinned-download.ts adapters/encoder-onnx/model-files.txt node_modules/.cache/nixie-encoder",
    "postinstall": "bun run --cwd apps/web codegen",
    "prepare": "command -v git > /dev/null 2>&1 && lefthook install --force || true",
    "prose": "chex prose README.md AGENTS.md ':(glob)docs/**/*.md' ':(glob)research/**/*.md' .agents/skills/project-ci-design .agents/skills/project-code-style .agents/skills/project-docs-writing .agents/skills/project-testing && chex skill",
    "test": "bun run models && bun run test:chromium && bun run test:bundles && bun run test:templates && rig unit",
    "test:chromium": "bun scripts/test-utils/check-playwright-chrome.ts && bun run --cwd guests/render playwright-core install chromium-headless-shell",
    "test:bundles": "bun apps/server/src/test-utils/write-test-bundles.ts",
    "test:templates": "bun apps/server/src/test-utils/write-test-templates.ts",
    "test:previous-release-build": "bun apps/server/src/test-utils/write-previous-release-build.ts",
    "test:web-build": "bun apps/web/src/test-utils/read-web-build.ts",
    "test:guest-bundles": "bun guests/conversation/src/test-utils/read-guest-bundles.ts",
    "test:backup-job-build": "bun apps/backup-job/src/test-utils/read-backup-job-bundle.ts",
    "test:backup-job-program": "bun run --cwd apps/backup-job build",
    "test:model-gateway-build": "bun apps/model-gateway/src/test-utils/read-model-gateway-binary.ts",
    "build:browser": "bun scripts/test-utils/install-browser-in-ci.ts && bun apps/web/src/test-utils/write-browser-build.ts",
    "test:browser": "bun scripts/test-utils/run-with-pinned-chrome.ts rig browser --path-ignore-patterns='apps/server/e2e/**' --path-ignore-patterns='apps/server/src/test-utils/start-web-journey.browser.test.ts'",
    "test:agent-sdk": "rig agent-sdk",
    "test:e2e": "bun run test:bundle && rig e2e",
    "test:bundle": "rig bundle",
    "test:journeys": "bun run test:bundles && bun scripts/test-utils/run-with-pinned-chrome.ts rig browser apps/server/e2e/ apps/server/src/test-utils/start-web-journey.browser.test.ts",
    "test:restic": "rig restic",
    "typecheck": "workers=$(bun scripts/read-worker-count.ts) && tsrs --fast --noEmit --checkers $workers && turbo run typecheck --concurrency=$workers -- --checkers $workers",
    "verify": "bun verify/src/verify/verify.ts",
    "verify:lint": "bun verify/src/verify/verify.ts lint",
    "ci:install-browser": "bun scripts/test-utils/check-playwright-chrome.ts && bun run --cwd guests/computer playwright-core install --with-deps chromium",
    "ci:verify-gate": "bun scripts/verify-gate/run-verify-gate.ts",
    "test:related": "bun run models && bun run test:chromium && bun run test:bundles && bun run test:templates && rig related",
    "ci:contract:check-forgettable-kinds": "bun run --cwd apps/server forgettable-kinds --check",
    "ci:compatibility:find-last-release": "bun scripts/compatibility/find-last-release.ts",
    "ci:compatibility:run-contract-growth-check": "bun scripts/compatibility/run-contract-growth-check.ts",
    "ci:compatibility:run-migration-check": "bun scripts/compatibility/run-migration-check.ts",
    "ci:compose:check-age-key": "bun scripts/compose/check-age-key.ts",
    "ci:compose:check-backup-credentials": "bun scripts/compose/check-backup-credentials.ts",
    "ci:compose:check-backup-published": "bun scripts/compose/check-backup-published.ts",
    "ci:compose:check-forwarded-proto": "bun scripts/compose/check-forwarded-proto.ts",
    "ci:compose:check-health-url": "bun scripts/compose/check-health-url.ts",
    "ci:compose:check-pinned-digests": "bun scripts/compose/check-pinned-digests.ts",
    "ci:compose:check-shipped-configs": "bun scripts/compose/check-shipped-configs.ts",
    "ci:compose:check-sign-in-code": "bun scripts/compose/check-sign-in-code.ts",
    "ci:compose:check-ticket-log": "bun scripts/compose/check-ticket-log.ts",
    "ci:compose:write-throwaway-secrets": "bun scripts/compose/write-throwaway-secrets.ts",
    "ci:config-schema:run-config-schema-check": "bun scripts/config-schema/run-config-schema-check.ts",
    "ci:definitions:check-task-yaml-format": "bun scripts/definitions/check-task-yaml-format.ts",
    "ci:images:check-backup-image": "bun scripts/images/check-backup-image.ts",
    "ci:images:check-computer-image": "bun scripts/images/check-computer-image.ts",
    "ci:images:check-codex-image": "bun scripts/images/check-codex-image.ts",
    "ci:images:check-conversation-image": "bun scripts/images/check-conversation-image.ts",
    "ci:images:check-carried-manifest": "bun scripts/images/check-carried-manifest.ts",
    "ci:images:check-image-size": "bun scripts/images/check-image-size.ts",
    "ci:images:check-public-pulls": "bun scripts/images/check-public-pulls.ts",
    "ci:images:check-printed-sandbox-images": "bun scripts/images/check-printed-sandbox-images.ts",
    "ci:images:rehearse-release-assets": "bun scripts/images/rehearse-release-assets.ts",
    "ci:images:run-restic-lane": "bun scripts/images/run-restic-lane.ts",
    "ci:images:tag-rehearsal-images": "bun scripts/images/tag-rehearsal-images.ts",
    "ci:images:write-sandbox-manifest": "bun scripts/images/write-sandbox-manifest.ts",
    "ci:release:check-unused-version": "bun scripts/release/check-unused-version.ts",
    "ci:release:publish-model-gateway": "bun scripts/release/publish-model-gateway.ts",
    "ci:release:publish-release-json": "bun scripts/release/publish-release-json.ts",
    "ci:release:record-sandbox-manifest": "bun scripts/release/record-sandbox-manifest.ts",
    "ci:release:resolve-release": "bun scripts/release/resolve-release.ts",
    "ci:release:tag-images": "bun scripts/release/tag-images.ts",
    "ci:release:write-release-notes": "bun scripts/release/write-release-notes.ts",
    "test:model-api": "rig model-api",
    "test:gpt-live": "rig gpt-live",
    "test:imp": "rig imp --config=bunfig.imp.toml",
    "test:userns": "rig userns",
    "check:docs": "chex prose length links readmes skill",
    "eval": "rig eval"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@stylistic/eslint-plugin": "6.0.1",
    "@tsconfig/strictest": "2.0.9",
    "@types/bun": "1.4.4",
    "@zgeoff/agent-hooks": "0.3.2",
    "@zgeoff/bun-test-extended": "0.2.4",
    "@zgeoff/bun-test-react": "0.2.4",
    "@zgeoff/chex": "0.4.7",
    "@zgeoff/commitlint-config": "0.1.2",
    "@zgeoff/diet": "0.3.2",
    "@zgeoff/format-codemod": "0.3.6",
    "@zgeoff/oxlint-config": "0.11.3",
    "@zgeoff/rig": "catalog:",
    "@zgeoff/testing": "catalog:",
    "ajv": "catalog:",
    "knip": "6.45.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "turbo": "2.11.11",
    "typescript": "catalog:"
  },
  "overrides": {
    "happy-dom": "21.0.4"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.4"
}
