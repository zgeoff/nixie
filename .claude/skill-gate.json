{
  "ignore": ["node_modules/", "dist/"],
  "gates": [
    { "match": "**/*.{ts,tsx}", "skills": ["code-style"] },
    { "match": "**/*.test.{ts,tsx}", "skills": ["testing", "project-testing"] },
    { "match": "**/test-utils/**", "skills": ["testing", "project-testing"] },
    { "match": "e2e/**", "skills": ["testing", "project-testing"] },
    { "match": "**/bunfig.toml", "skills": ["testing", "project-testing"] },
    { "match": "**/*.md", "skills": ["docs-writing", "project-docs-writing"] },
    { "match": "**/skills/*/SKILL.md", "skills": ["skill-writing", "docs-writing", "deslop"] },
    { "match": "**/skills/*/references/**", "skills": ["skill-writing", "docs-writing", "deslop"] },
    { "match": "apps/server/**", "skills": ["verify"] },
    { "match": "apps/web/**", "skills": ["verify"] },
    { "match": "modules/**", "skills": ["verify"] },
    { "match": "libs/**", "skills": ["verify"] },
    { "match": "guests/**", "skills": ["verify"] },
    { "match": "adapters/definitions-repo-github/**", "skills": ["verify"] },
    { "match": "adapters/encoder-onnx/**", "skills": ["verify"] },
    { "match": "adapters/search-kagi/**", "skills": ["verify"] },
    { "match": "nixie-test-build.d.ts", "skills": ["verify"] },
    { "match": "bun-serve-options.d.ts", "skills": ["verify"] },
    { "match": "e2e/src/verify/**", "skills": ["verify"] },
    { "match": "preview/**", "skills": ["verify"] }
  ]
}
