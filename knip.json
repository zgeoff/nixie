{
  "$schema": "./node_modules/knip/schema.json",
  // repo-sync delivers .claude/ verbatim, and the CLI loads the SDK contract probes' mods by their
  // paths, so no import reaches their files
  "ignore": [".claude/**", "guests/conversation/src/sdk-contract/mods/**"],
  "ignoreWorkspaces": ["research/**"],
  // the Bun plugin takes its test files from a `bun test` script, and rig runs the root's tests
  "bun": { "entry": ["**/*.test.{ts,tsx}"] },
  // the shared oxlint config loads the plugin, the synced start-up stub in .claude/ imports
  // the package, and only the hooks run diet, so knip sees none of them
  "ignoreDependencies": ["@stylistic/eslint-plugin", "@zgeoff/agent-hooks", "@zgeoff/diet"],
  "workspaces": {
    // a test spawns the stub program as its own process, so no import reaches it
    "modules/log": { "entry": ["src/test-utils/run-stub-*.ts"] },
    // the backup image runs the bundle of main.ts, and tests spawn the restic stand-in, so no
    // import reaches either
    "apps/backup-job": { "entry": ["src/main.ts", "src/test-utils/run-stub-*.ts"] },
    "libs/testing": { "entry": ["src/test-utils/run-stub-*.ts"] },
    // the image build and `bun run models` run the pinned download by its path, so no import
    // reaches it
    "adapters/encoder-onnx": { "entry": ["src/run-pinned-download.ts"] },
    // the nixie image runs the bundle of main.ts, the image build runs the release build, tests
    // spawn the sops and fetcher stand-ins, and the workflows run the config schema check and the release.json
    // script, so no import reaches them
    // the release builds the model gateway binary from main.ts, so no import reaches it
    "apps/model-gateway": { "entry": ["src/main.ts"] },
    "apps/server": {
      "entry": [
        "src/main.ts",
        "src/run-release-build.ts",
        "src/test-utils/write-previous-release-build.ts",
        "src/test-utils/run-stub-*.ts",
        "src/run-config-schema-check.ts",
        "src/run-release-manifest.ts",
        "src/run-preview-route-config.ts"
      ]
    },
    // the release workflows run the migration check and the schema report by their paths, and the
    // schema loader reaches each migration file by listing its folder, so no import reaches them
    "libs/db": {
      "entry": [
        "src/run-migration-check.ts",
        "src/run-schema-report.ts",
        "src/migrations/[0-9][0-9][0-9][0-9]-*.ts"
      ]
    },
    // the conversation image runs its guest's entries by their paths, so no import reaches them
    "guests/conversation": { "entry": ["src/main.ts", "src/check.ts"] },
    // an eval run is a script a contributor runs by its path
    "evals": { "entry": ["*/run-*-eval.ts"] },
    // TanStack Router loads each route file by its path, and Vite loads the PostCSS config by its
    // name, so no import reaches them
    "apps/web": { "entry": ["src/routes/**/*.tsx", "postcss.config.js"] },
    // `bun verify` runs the verify CLI by its path, and the CLI launches the harness by its path,
    // so no import reaches either
    "e2e": { "entry": ["src/verify/verify.ts", "src/verify/harness/run-verify-harness.ts"] },
    // rig loads its config and the lane start hooks by path
    ".": {
      "entry": ["rig.config.ts", "scripts/test-utils/prepare-*-lane.ts"]
    }
  }
}
