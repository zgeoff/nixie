{
  "$schema": "./node_modules/knip/schema.json",
  // repo-sync delivers .claude/ verbatim, and design spikes install and run on their own
  "ignore": [".claude/**", "docs/design/**"],
  // the shared oxlint config loads this plugin, which knip cannot see through
  "ignoreDependencies": ["@stylistic/eslint-plugin"],
  "workspaces": {
    // a crash test spawns the test build of nixie by its path, and a live check's test spawns the
    // kubectl stand-in, so no import reaches them
    ".": { "entry": ["e2e/nixie/main.ts", "e2e/k3s/test-utils/run-stub-*.ts"] },
    // a test spawns the stub program as its own process, so no import reaches it
    "modules/log": { "entry": ["src/test-utils/run-stub-*.ts"] },
    "libs/testing": { "entry": ["src/test-utils/run-stub-*.ts"] },
    // the nixie image runs the bundle of main.ts, the image build runs the release build, and a test
    // spawns the sops stand-in, so no import reaches them
    "apps/server": {
      "entry": ["src/main.ts", "src/run-release-build.ts", "src/test-utils/run-stub-sops.ts"]
    },
    // the release workflows run the migration check and the schema report by their paths, so no
    // import reaches them
    "libs/db": { "entry": ["src/run-migration-check.ts", "src/run-schema-report.ts"] },
    // the conversation image runs its guest's entry by its path, so no import reaches it
    "guests/conversation": { "entry": ["src/main.ts"] },
    // TanStack Router loads each route file by its path, and Vite loads the PostCSS config by its
    // name, so no import reaches them
    "apps/web": { "entry": ["src/routes/**/*.tsx", "postcss.config.js"] }
  }
}
