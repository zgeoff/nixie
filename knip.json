{
  "$schema": "./node_modules/knip/schema.json",
  // repo-sync delivers .claude/ verbatim, and the CLI loads the SDK contract suite's mods by their
  // paths, so no import reaches their files
  "ignore": [".claude/**", "evals/sdk-contract/mods/**"],
  "ignoreWorkspaces": ["research/**"],
  // the shared oxlint config loads the plugin, and the synced skill-gate hook in .claude/ imports
  // the package, so knip sees neither
  "ignoreDependencies": ["@stylistic/eslint-plugin", "@zgeoff/skill-gate"],
  // knip resolves the root test:browser script's preload from every workspace too, where its
  // root-relative path misses; from the root it finds the file
  "ignoreUnresolved": ["./apps/web/src/test-utils/start-browser.ts"],
  "workspaces": {
    // a test spawns the stub program as its own process, so no import reaches it
    "modules/log": { "entry": ["src/test-utils/run-stub-*.ts"] },
    "libs/testing": { "entry": ["src/test-utils/run-stub-*.ts"] },
    // the image build and `bun run models` run the pinned download by its path, so no import
    // reaches it
    "adapters/encoder-onnx": { "entry": ["src/run-pinned-download.ts"] },
    // the nixie image runs the bundle of main.ts, the image build runs the release build, tests
    // spawn the sops and fetcher stand-ins, and the workflows run the config schema check and the release.json
    // script, so no import reaches them
    // the release builds the counting proxy binary from main.ts, so no import reaches it
    "apps/counting-proxy": { "entry": ["src/main.ts"] },
    "apps/server": {
      "entry": [
        "src/main.ts",
        "src/run-release-build.ts",
        "src/test-utils/run-stub-*.ts",
        "src/run-config-schema-check.ts",
        "src/run-release-manifest.ts",
        "src/run-preview-route-config.ts"
      ]
    },
    // the release workflows run the migration check and the schema report by their paths, so no
    // import reaches them
    "libs/db": { "entry": ["src/run-migration-check.ts", "src/run-schema-report.ts"] },
    // the conversation image runs its guest's entries by their paths, so no import reaches them
    "guests/conversation": { "entry": ["src/main.ts", "src/check.ts"] },
    // an eval run is a script a contributor runs by its path
    "evals": { "entry": ["*/run-*-eval.ts"] },
    // TanStack Router loads each route file by its path, and Vite loads the PostCSS config by its
    // name, so no import reaches them
    "apps/web": { "entry": ["src/routes/**/*.tsx", "postcss.config.js"] }
  }
}
