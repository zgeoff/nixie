{
  "$schema": "./node_modules/knip/schema.json",
  // repo-sync delivers .claude/ verbatim, and spikes run by hand, so no import reaches their files
  "ignore": [".claude/**", "docs/design/**"],
  "ignoreWorkspaces": ["research/**"],
  // the shared oxlint config loads this plugin, which knip cannot see through
  "ignoreDependencies": ["@stylistic/eslint-plugin"],
  "workspaces": {
    // a crash test spawns the test build of nixie by its path, and a codemod in scripts ran once
    // by its path and stays as the record of a mechanical change, so no import reaches either
    ".": { "entry": ["e2e/nixie/main.ts", "scripts/*.ts"] },
    // a test spawns the stub program as its own process, so no import reaches it
    "modules/log": { "entry": ["src/test-utils/run-stub-*.ts"] },
    "libs/testing": { "entry": ["src/test-utils/run-stub-*.ts"] },
    // the image build and `bun run models` run the pinned download by its path, so no import
    // reaches it
    "adapters/encoder-onnx": { "entry": ["src/run-pinned-download.ts"] },
    // the nixie image runs the bundle of main.ts, the image build runs the release build, a test
    // spawns the sops stand-in, and the workflows run the config schema check and the release.json
    // script, so no import reaches them
    "apps/server": {
      "entry": [
        "src/main.ts",
        "src/run-release-build.ts",
        "src/test-utils/run-stub-sops.ts",
        "src/run-config-schema-check.ts",
        "src/run-release-manifest.ts"
      ]
    },
    // the release workflows run the migration check and the schema report by their paths, so no
    // import reaches them
    "libs/db": { "entry": ["src/run-migration-check.ts", "src/run-schema-report.ts"] },
    // the conversation image runs its guest's entries by their paths, so no import reaches them
    "guests/conversation": { "entry": ["src/main.ts", "src/check.ts"] },
    // an eval run is a script a contributor runs by its path
    "evals": { "entry": ["*/run-*-eval.ts"] },
    // TanStack Router loads each route file by its path, and Vite loads the PostCSS config by its
    // name, so no import reaches them
    "apps/web": { "entry": ["src/routes/**/*.tsx", "postcss.config.js"] }
  }
}
