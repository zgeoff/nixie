{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "bun.lock",
    // verbatim copies that repo-sync delivers from zgeoff/tools; edit them there
    ".claude/skills/docs-writing/**",
    ".claude/skills/testing/**",
    ".claude/hooks/skill-gate/**",
    // generated by TanStack Router on every web build
    "apps/web/src/routeTree.gen.ts",
    // written by panda codegen on install
    "apps/web/src/styled-system/**",
    // written by run-openapi-document.ts and run-config-json-schema.ts, and by release-please on
    // each release
    "libs/contract/openapi.json",
    "apps/server/config.schema.json",
    "CHANGELOG.md",
    ".release-please-manifest.json",
    // design spikes are throwaway code; only their Markdown is formatted
    "docs/design/**/spikes/**",
    "!docs/design/**/spikes/**/*.md",
    "research/**",
    "!research/**/*.md"
  ],
  "proseWrap": "always",
  "semi": true,
  "trailingComma": "all",
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "arrowParens": "always",
  "sortImports": {
    "groups": ["side_effect", "builtin", "external", "unknown", ["parent", "sibling", "index"]],
    "newlinesBetween": false,
    "sortSideEffects": false
  }
}
