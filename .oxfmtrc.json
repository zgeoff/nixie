{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "bun.lock",
    // verbatim copies that repo-sync delivers from zgeoff/tools; edit them there
    ".agents/skills/code-style/**",
    ".claude/skills/code-style/**",
    ".agents/skills/docs-writing/**",
    ".claude/skills/docs-writing/**",
    ".agents/skills/skill-writing/**",
    ".claude/skills/skill-writing/**",
    ".agents/skills/testing/**",
    ".claude/skills/testing/**",
    ".claude/hooks/start.ts",
    // generated by TanStack Router on every web build
    "apps/web/src/routeTree.gen.ts",
    // written by panda codegen on install
    "apps/web/src/styled-system/**",
    // written by `codex app-server generate-ts` for the pinned CLI
    "guests/codex/src/protocol/**",
    // written by run-openapi-document.ts, run-config-json-schema.ts, run-manifest-json-schema.ts and
    // run-rules-json-schema.ts, and by release-please on each release
    "libs/contract/openapi.json",
    "apps/server/config.schema.json",
    "modules/definitions/definitions-manifest.schema.json",
    "modules/policy/definitions-rules.schema.json",
    "modules/policy/definitions-budgets.schema.json",
    // written by the secret scan lib's rule builder, and the pin check compares its bytes
    "libs/secret-scan/src/generated/public-rules.generated.ts",
    "CHANGELOG.md",
    ".release-please-manifest.json",
    // spikes are throwaway code; only their Markdown is formatted
    "research/**/*.*",
    "!research/**/*.md"
  ],
  "proseWrap": "always",
  "semi": true,
  "trailingComma": "all",
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "arrowParens": "always",
  "sortImports": {
    "groups": ["side_effect", "builtin", "external", "unknown", ["parent", "sibling", "index"]],
    "newlinesBetween": false,
    "sortSideEffects": false
  }
}
